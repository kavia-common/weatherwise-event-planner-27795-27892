# Runtime environment
ENV=development
DEBUG=false

# CORS: comma-separated origins. Keep localhost:3000 for the frontend.
CORS_ALLOW_ORIGINS=http://localhost:3000

# Optional: site URL for email redirect scenarios
SITE_URL=http://localhost:3000

# Email (optional placeholders, console stub used by default)
EMAIL_SENDER=no-reply@example.com
EMAIL_SMTP_URL=

# Weather provider placeholders (not required for Open-Meteo + Nominatim usage)
WEATHER_API_BASE_URL=
WEATHER_API_KEY=
