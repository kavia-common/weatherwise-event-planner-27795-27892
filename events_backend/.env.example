# Runtime environment
ENV=development
DEBUG=false

# CORS
CORS_ALLOW_ORIGINS=*

# Weather provider config (optional)
WEATHER_API_BASE_URL=
WEATHER_API_KEY=

# Email/notification defaults (optional)
EMAIL_SENDER=no-reply@example.com
EMAIL_SMTP_URL=

# Public site URL for redirects (if used in emails)
SITE_URL=http://localhost:3000
