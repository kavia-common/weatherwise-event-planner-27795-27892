# WeatherWise Events - Backend (.env.example)
# Copy to ".env" and adjust values for your environment.
# The backend reads this file via python-dotenv at startup (see src/core/config.py).

# --- Runtime ---
ENV=development
# DEBUG enables verbose logging and developer-friendly behavior
DEBUG=false

# --- CORS ---
# Comma-separated list of allowed origins for browsers.
# Example (development): http://localhost:3000,http://127.0.0.1:3000
# Use "*" to allow all (not recommended for production).
CORS_ALLOW_ORIGINS=http://localhost:3000

# --- Server Binding ---
# Host and port for the FastAPI server to bind to.
# Default host 0.0.0.0 is required in containers to accept external traffic.
HOST=0.0.0.0
# The platform expects the backend to listen on 3001.
PORT=3001

# --- Site / Routing ---
# Optional: Public site base URL if you need to generate absolute links in emails, etc.
# Example: https://weatherwise.example.com
SITE_URL=

# --- External Weather Provider (optional, currently not required for Open-Meteo usage) ---
# If integrating a different weather provider, you can set a base URL and API key.
WEATHER_API_BASE_URL=
WEATHER_API_KEY=

# --- Email / Notifications (optional; console logging by default) ---
# Default "from" address for emails when a real provider is added.
EMAIL_SENDER=no-reply@example.com
# SMTP connection URL if you plug a real SMTP service in the future.
# e.g., smtp://user:pass@smtp.example.com:587
EMAIL_SMTP_URL=
