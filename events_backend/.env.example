# Runtime mode
ENV=development
DEBUG=false

# CORS
# Comma-separated origins, use "*" for all
CORS_ALLOW_ORIGINS=*

# Weather provider (future integration)
WEATHER_API_BASE_URL=
WEATHER_API_KEY=

# Email/notifications (future integration)
EMAIL_SENDER=
EMAIL_SMTP_URL=

# Public site URL (used for notifications/redirects)
SITE_URL=http://localhost:3000
